# Git Ignore for Polyglot Agentic Template

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Node / JS / TS (Next.js, Vue, Svelte)
node_modules/
.next/
.nuxt/
.svelte-kit/
dist/
build/
out/
.turbo/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
dist/
*.egg-info/

# .NET / C#
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
TestResults/
*.nupkg

# Go
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Agent Scratch & Logs
*.log
.agent-scratch/
